{
  "name": "smartfit-app",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch backend/src/dev.js",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node backend/src/server.js",
    "build": "vite build",
    "test": "node --test backend/test/*.test.js frontend/test/*.test.js",
    "test:production": "node --test backend/test/production.smoke.js",
    "preview": "npm run build && node backend/src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "multer": "^2.0.2",
    "sharp": "^0.34.4",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
