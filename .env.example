# Node 24+ can load this with: node --env-file=.env backend/src/server.js
PORT=3001
# Optional absolute path; default backend/data
# DATA_DIR=/absolute/path/to/data
# Optional persistent 32-byte encryption key (64 hex chars).
# Default: generated at first startup in backend/data/secret.key (gitignored).
# DATA_ENCRYPTION_KEY=
# Set true only when served over HTTPS.
COOKIE_SECURE=false
# All external integrations in this release use local demo adapters.
# No vendor credentials are required or consumed by this version.
